{
  "name": "@heroui-svelte/ui",
  "version": "3.0.1",
  "description": "Svelte 5 UI library for heroui-svelte.",
  "license": "MIT",
  "type": "module",
  "author": "heroui-svelte <opensource@heroui-svelte.dev>",
  "homepage": "https://github.com/heroui-svelte/ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroui-svelte/ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src"
  ],
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    },
    "./styles": {
      "default": "./src/lib/styles.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && node scripts/generate-roots.mjs && svelte-package",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "svelte-kit sync && node scripts/generate-roots.mjs && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@heroui-svelte/styles": "workspace:*",
    "bits-ui": "^1.8.0",
    "tailwind-variants": "3.2.2"
  },
  "devDependencies": {
    "@heroui/standard": "workspace:*",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "25.0.3",
    "jsdom": "^25.0.1",
    "svelte": "^5.39.3",
    "svelte-check": "^4.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
